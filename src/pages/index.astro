---
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/600.css';
import '@fontsource/archivo/700.css';
import '../styles/resume.css';
import { resume as r } from '../data/resume';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const pageUrl = Astro.site ? new URL(base, Astro.site).href : undefined;
// scripts/pdf.mjs reads this link's download name, so the file name lives in one place.
const pdfFile = `${r.name.replace(/\s+/g, '-')}-Resume.pdf`;
const favicon = `data:image/svg+xml,${encodeURIComponent(
  "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='#c8290f'/><text x='16' y='21.5' font-family='Arial,sans-serif' font-size='14' font-weight='700' text-anchor='middle' fill='#fff'>KK</text></svg>",
)}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{r.name} — Resume</title>
    <meta name="description" content={r.summary} />
    <meta name="author" content={r.name} />
    <meta name="keywords" content={r.skills.map((s) => s.value).join(', ')} />
    <link rel="icon" href={favicon} />
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={`${r.name} — ${r.headline}`} />
    <meta property="og:description" content={r.summary} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
  </head>
  <body>
    <nav class="toolbar">
      <a class="download" href={`${base}${pdfFile}`} download={pdfFile}>Download PDF</a>
    </nav>
    <main class="page">
      <header class="head">
        <h1>{r.name}</h1>
        <p class="headline">{r.headline}</p>
        {r.contact.map((row) => (
          <p class="contact">
            {row.map((c, i) => (
              <>
                {i > 0 && <span class="sep"> | </span>}
                {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
              </>
            ))}
          </p>
        ))}
      </header>

      <section>
        <h2>Professional Summary</h2>
        <p>{r.summary}</p>
      </section>

      <section>
        <h2>Skills</h2>
        <ul class="rows">
          {r.skills.map((s) => <li><strong>{s.label}:</strong> {s.value}</li>)}
          <li><strong>Spoken Languages:</strong> {r.languages}</li>
        </ul>
      </section>

      <section>
        <h2>Professional Experience</h2>
        {r.experience.map((job) => (
          <article class="entry">
            <div class="line">
              <h3>{job.title}</h3>
              <span class="date">{job.dates}</span>
            </div>
            <p class="org"><span>{job.company}</span><span class="sep"> | </span><span>{job.location}</span></p>
            <ul class="bullets">
              {job.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </article>
        ))}
      </section>

      <section>
        <h2>Education</h2>
        {r.education.map((e) => (
          <div class="entry">
            <div class="line">
              <h3>{e.degree}</h3>
              <span class="date">{e.dates}</span>
            </div>
            <p class="org"><span>{e.school}</span><span class="sep"> | </span><span>{e.location}</span></p>
          </div>
        ))}
      </section>
    </main>
  </body>
</html>
